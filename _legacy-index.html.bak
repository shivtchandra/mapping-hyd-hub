<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f4ec" />
    <meta
      name="description"
      content="Mapping HYD is a growing digital atlas of Hyderabad—startups, food, neighbourhoods, lakes, escapes and heritage, mapped one layer at a time."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://mapmyhyd.com/" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;600&family=Source+Sans+3:wght@400;500;600&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Mapping HYD" />
    <meta property="og:title" content="Mapping HYD — Hyderabad, one layer at a time." />
    <meta
      property="og:description"
      content="A growing digital atlas of Hyderabad, built as focused tools for the questions the city asks every day."
    />
    <meta property="og:url" content="https://mapmyhyd.com/" />
    <meta property="og:image" content="https://mapmyhyd.com/assets/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mapping HYD illustration featuring Charminar, Hyderabad Metro, HITEC City, a lake and Irani chai." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Mapping HYD — Hyderabad, one layer at a time." />
    <meta
      name="twitter:description"
      content="A growing digital atlas of Hyderabad, built one useful layer at a time."
    />
    <meta name="twitter:image" content="https://mapmyhyd.com/assets/og-image.jpg" />

    <title>Mapping HYD — Hyderabad, one layer at a time.</title>

    <script>
      document.documentElement.classList.add("js");
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://mapmyhyd.com/#website",
            "url": "https://mapmyhyd.com/",
            "name": "Mapping HYD",
            "description": "A growing digital atlas of Hyderabad, built one layer at a time.",
            "inLanguage": "en-IN",
            "publisher": { "@id": "https://mapmyhyd.com/#organization" }
          },
          {
            "@type": "Organization",
            "@id": "https://mapmyhyd.com/#organization",
            "name": "Mapping HYD",
            "url": "https://mapmyhyd.com/",
            "logo": "https://mapmyhyd.com/assets/favicon.svg"
          }
        ]
      }
    </script>

    <style>
      :root {
        --paper: #f7f4ec;
        --paper-deep: #eee9dc;
        --ink: #151515;
        --muted: #6d675e;
        --line: #cfc8b8;
        --startup: #175cd3;
        --eats: #e84c3d;
        --forest: #2e6b4f;
        --lake: #2f7fa3;
        --heritage: #c98b2e;
        --display: "Archivo Black", "Arial Black", sans-serif;
        --body: "Source Sans 3", "Helvetica Neue", sans-serif;
        --mono: "IBM Plex Mono", monospace;
        --page: min(100% - 40px, 1320px);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--body);
        font-size: 18px;
        line-height: 1.45;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
      }

      a:focus-visible {
        outline: 3px solid var(--startup);
        outline-offset: 5px;
      }

      .site-header {
        width: var(--page);
        min-height: 80px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 28px;
        border-bottom: 1px solid var(--ink);
      }

      .wordmark,
      .header-link,
      .live-count,
      .eyebrow,
      .layer-number,
      .layer-status,
      .footer-meta {
        font-family: var(--mono);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .wordmark {
        font-size: 0.82rem;
      }

      .header-link {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        font-size: 0.72rem;
        text-decoration-thickness: 1px;
        text-underline-offset: 5px;
      }

      .live-count {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.72rem;
      }

      .live-count::before {
        content: "";
        width: 8px;
        height: 8px;
        background: var(--eats);
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(232, 76, 61, 0.13);
      }

      main {
        overflow: clip;
      }

      .hero {
        position: relative;
        width: var(--page);
        min-height: calc(100svh - 80px);
        margin: 0 auto;
        border-bottom: 1px solid var(--ink);
        overflow: hidden;
        isolation: isolate;
      }

      .hero-background {
        position: absolute;
        inset: 0;
        z-index: -2;
        display: block;
      }

      .hero-background::after {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 58%;
        background: rgba(247, 244, 236, 0.42);
        border-right: 1px solid rgba(207, 200, 184, 0.5);
        backdrop-filter: blur(1px);
      }

      .hero-background picture,
      .hero-background img {
        display: block;
        width: 100%;
        height: 100%;
      }

      .hero-background img {
        object-fit: cover;
        object-position: center;
      }

      .hero-copy {
        position: relative;
        z-index: 2;
        width: 57%;
        min-height: calc(100svh - 80px);
        padding: clamp(64px, 9vw, 128px) clamp(28px, 5vw, 74px) 64px 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .eyebrow {
        margin: 0 0 clamp(32px, 5vw, 72px);
        font-size: 0.72rem;
        color: var(--startup);
      }

      .hero h1 {
        max-width: 760px;
        margin: 0;
        font-family: var(--display);
        font-size: clamp(4.1rem, 8.8vw, 9.5rem);
        font-weight: 400;
        letter-spacing: -0.075em;
        line-height: 0.79;
        text-transform: uppercase;
      }

      .hero h1 span {
        display: block;
      }

      .hero-tagline {
        max-width: 520px;
        margin: clamp(32px, 5vw, 64px) 0 0;
        font-size: clamp(1.55rem, 2.7vw, 2.65rem);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: -0.035em;
      }

      .hero-summary {
        max-width: 510px;
        margin: 22px 0 0;
        color: var(--muted);
        font-size: clamp(1rem, 1.3vw, 1.2rem);
      }

      .hero-cta {
        min-height: 48px;
        margin-top: 38px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        border-bottom: 2px solid var(--ink);
        font-family: var(--mono);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 160ms ease, border-color 160ms ease;
      }

      .hero-cta span {
        color: var(--eats);
        font-size: 1.1rem;
        transition: transform 160ms ease;
      }

      .hero-cta:hover {
        color: var(--startup);
        border-color: var(--startup);
      }

      .hero-cta:hover span {
        transform: translateY(3px);
      }

      .atlas-background {
        background-image: url("/assets/page-atlas.webp");
        background-repeat: no-repeat;
        background-position: center top;
        background-size: auto 100%;
      }

      .purpose {
        width: var(--page);
        margin: 0 auto;
        padding: clamp(88px, 13vw, 190px) 0;
        display: grid;
        grid-template-columns: minmax(150px, 0.3fr) minmax(0, 1fr);
        gap: clamp(44px, 8vw, 128px);
        border-bottom: 1px solid var(--ink);
        background: rgba(247, 244, 236, 0.79);
        backdrop-filter: blur(1.5px);
      }

      .section-label {
        margin: 8px 0 0;
        font-family: var(--mono);
        color: var(--muted);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .purpose-copy {
        max-width: 980px;
        margin: 0;
        font-size: clamp(2rem, 4.8vw, 4.8rem);
        font-weight: 500;
        line-height: 1.04;
        letter-spacing: -0.045em;
      }

      .purpose-copy em {
        color: var(--eats);
        font-style: normal;
      }

      .layers {
        width: var(--page);
        margin: 0 auto;
        padding: clamp(88px, 10vw, 144px) 0 clamp(100px, 12vw, 176px);
        background: rgba(247, 244, 236, 0.8);
        backdrop-filter: blur(1.5px);
      }

      .layers-heading {
        margin: 0 0 34px;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 20px;
      }

      .layers-heading h2 {
        margin: 0;
        font-family: var(--display);
        font-size: clamp(2.6rem, 6vw, 6.2rem);
        font-weight: 400;
        letter-spacing: -0.06em;
        line-height: 0.95;
        text-transform: uppercase;
      }

      .layers-heading p {
        margin: 0;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .layer-list {
        border-top: 1px solid var(--ink);
      }

      .layer-row {
        --accent: var(--ink);
        position: relative;
        min-height: 144px;
        display: grid;
        grid-template-columns: 90px minmax(240px, 0.8fr) minmax(280px, 1fr) 170px 54px;
        align-items: center;
        gap: 24px;
        border-bottom: 1px solid var(--line);
        color: inherit;
        text-decoration: none;
      }

      .layer-row.live {
        transition: background-color 180ms ease, padding 180ms ease;
      }

      .layer-row.live:hover {
        padding: 0 18px;
        background: var(--paper-deep);
      }

      .layer-number {
        color: var(--accent);
        font-size: 0.75rem;
      }

      .layer-name {
        margin: 0;
        font-size: clamp(1.35rem, 2vw, 2rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.05;
      }

      .layer-description {
        max-width: 560px;
        margin: 0;
        color: var(--muted);
        font-size: 1rem;
      }

      .layer-status {
        justify-self: end;
        color: var(--muted);
        font-size: 0.66rem;
        text-align: right;
      }

      .live .layer-status {
        color: var(--accent);
      }

      .layer-arrow {
        width: 44px;
        height: 44px;
        justify-self: end;
        display: grid;
        place-items: center;
        border: 1px solid var(--ink);
        background: var(--ink);
        color: var(--paper);
        box-shadow: inset 0 1px rgba(255, 255, 255, 0.16), 0 3px 0 rgba(0, 0, 0, 0.22);
        font-size: 1.2rem;
        transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
      }

      .live:hover .layer-arrow {
        background: var(--accent);
        transform: translate(2px, -2px);
        box-shadow: inset 0 1px rgba(255, 255, 255, 0.16), -2px 5px 0 rgba(0, 0, 0, 0.2);
      }

      .live:active .layer-arrow {
        transform: translateY(2px);
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.25), 0 1px 0 rgba(0, 0, 0, 0.18);
      }

      .layer-row:not(.live) .layer-arrow {
        border-color: var(--line);
        background: transparent;
        box-shadow: none;
        color: var(--line);
      }

      .layer-row[data-layer="startup"] { --accent: var(--startup); }
      .layer-row[data-layer="eats"] { --accent: var(--eats); }
      .layer-row[data-layer="live"] { --accent: var(--forest); }
      .layer-row[data-layer="escapes"] { --accent: var(--forest); }
      .layer-row[data-layer="lakes"] { --accent: var(--lake); }
      .layer-row[data-layer="heritage"] { --accent: var(--heritage); }

      .js .layer-row.reveal-ready {
        opacity: 0;
        transform: translateY(20px);
      }

      .js .layer-row.reveal-ready.is-visible {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 520ms ease, transform 520ms cubic-bezier(0.2, 0.75, 0.25, 1), background-color 180ms ease, padding 180ms ease;
      }

      .site-footer {
        background: var(--ink);
        color: var(--paper);
      }

      .footer-inner {
        width: var(--page);
        min-height: 240px;
        margin: 0 auto;
        padding: 52px 0;
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: 28px;
      }

      .footer-title {
        margin: 0;
        font-family: var(--display);
        font-size: clamp(2.7rem, 6vw, 6.5rem);
        font-weight: 400;
        letter-spacing: -0.06em;
        line-height: 0.85;
        text-transform: uppercase;
      }

      .footer-meta {
        margin: 0;
        color: #c5beb0;
        font-size: 0.68rem;
        text-align: right;
      }

      @media (max-width: 980px) {
        :root {
          --page: min(100% - 32px, 760px);
        }

        .hero {
          min-height: auto;
        }

        .hero-copy {
          width: 66%;
          min-height: calc(100svh - 72px);
          padding-right: 0;
        }

        .hero-background::after {
          width: 68%;
        }

        .layer-row {
          grid-template-columns: 60px minmax(0, 1fr) 140px 54px;
          min-height: 160px;
        }

        .layer-description {
          grid-column: 2 / 4;
          margin-top: -38px;
          padding-right: 18px;
        }

        .layer-status {
          grid-column: 3;
          grid-row: 1;
        }

        .layer-arrow {
          grid-column: 4;
          grid-row: 1 / 3;
        }
      }

      @media (max-width: 620px) {
        :root {
          --page: calc(100% - 28px);
        }

        body {
          font-size: 17px;
        }

        .site-header {
          min-height: 72px;
          grid-template-columns: 1fr auto;
          gap: 14px;
        }

        .header-link {
          display: none;
        }

        .wordmark,
        .live-count {
          font-size: 0.66rem;
        }

        .hero-copy {
          width: 100%;
          min-height: calc(100svh - 72px);
          padding: 52px 0 40px;
        }

        .hero-background::after {
          width: 100%;
          background: rgba(247, 244, 236, 0.35);
          border-right: 0;
        }

        .hero-background img {
          object-position: center bottom;
        }

        .eyebrow {
          margin-bottom: 34px;
        }

        .hero h1 {
          font-size: clamp(3.4rem, 17vw, 5rem);
          letter-spacing: -0.065em;
        }

        .hero-tagline {
          margin-top: 40px;
          font-size: clamp(1.75rem, 9vw, 2.55rem);
        }

        .hero-summary {
          font-size: 1.02rem;
        }

        .hero-cta {
          margin-top: 28px;
        }

        .purpose {
          grid-template-columns: 1fr;
          gap: 34px;
        }

        .purpose-copy {
          font-size: clamp(2rem, 10.5vw, 3.25rem);
        }

        .layers-heading {
          align-items: flex-end;
        }

        .layers-heading p {
          max-width: 110px;
          text-align: right;
        }

        .layer-row {
          min-height: 0;
          padding: 28px 0;
          grid-template-columns: 42px minmax(0, 1fr) 46px;
          gap: 12px;
        }

        .layer-row.live:hover {
          padding: 28px 8px;
        }

        .layer-name {
          font-size: 1.4rem;
        }

        .layer-description {
          grid-column: 2 / 4;
          margin: 4px 0 0;
          padding-right: 0;
          font-size: 0.96rem;
        }

        .layer-status {
          grid-column: 2;
          grid-row: 3;
          justify-self: start;
          margin-top: 10px;
          text-align: left;
        }

        .layer-arrow {
          grid-column: 3;
          grid-row: 1;
        }

        .footer-inner {
          min-height: 280px;
          grid-template-columns: 1fr;
          align-content: space-between;
        }

        .footer-meta {
          text-align: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }

        .js .layer-row.reveal-ready {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wordmark">Mapping HYD.</div>
      <a class="header-link" href="#layers">The layers</a>
      <div class="live-count" aria-label="Two maps live">02 live</div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-background" aria-hidden="true">
          <picture>
            <source media="(max-width: 700px)" srcset="/assets/campaign-expanded.webp" type="image/webp" />
            <source media="(max-width: 700px)" srcset="/assets/campaign-expanded.jpg" type="image/jpeg" />
            <source srcset="/assets/hero-full.webp" type="image/webp" />
            <img src="/assets/hero-full.jpg" width="1672" height="941" alt="" fetchpriority="high" decoding="async" />
          </picture>
        </div>
        <div class="hero-copy">
          <p class="eyebrow">A living atlas of Hyderabad · Est. 2026</p>
          <h1 id="hero-title"><span>Mapping</span><span>HYD.</span></h1>
          <p class="hero-tagline">Hyderabad, one layer at a time.</p>
          <p class="hero-summary">
            A growing digital atlas of the city—built as focused tools for the questions Hyderabad asks every day.
          </p>
          <a class="hero-cta" href="#layers">Explore the live maps <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <div class="atlas-background">
      <section class="purpose" aria-labelledby="purpose-label">
        <p class="section-label" id="purpose-label">What this is</p>
        <p class="purpose-copy">
          Hyderabad has the data, places and stories. <em>They are scattered.</em> Mapping HYD turns them into useful,
          searchable maps—one layer at a time.
        </p>
      </section>

      <section class="layers" id="layers" aria-labelledby="layers-title">
        <div class="layers-heading">
          <h2 id="layers-title">The layers</h2>
          <p>02 live · 04 in progress</p>
        </div>

        <div class="layer-list">
          <a class="layer-row live" data-layer="startup" href="/startups">
            <span class="layer-number">01</span>
            <h3 class="layer-name">Hyderabad Startup Map</h3>
            <p class="layer-description">Find startups, open jobs and funding across the city.</p>
            <span class="layer-status">Live</span>
            <span class="layer-arrow" aria-hidden="true">↗</span>
          </a>

          <a class="layer-row live" data-layer="eats" href="/eats">
            <span class="layer-number">02</span>
            <h3 class="layer-name">Eateries Race</h3>
            <p class="layer-description">Discover places to eat, vote, check in and climb the city leaderboard.</p>
            <span class="layer-status">Live</span>
            <span class="layer-arrow" aria-hidden="true">↗</span>
          </a>

          <article class="layer-row" data-layer="live">
            <span class="layer-number">03</span>
            <h3 class="layer-name">Where to Live</h3>
            <p class="layer-description">Compare neighbourhoods by cost, commute, water and flood risk.</p>
            <span class="layer-status">In development</span>
            <span class="layer-arrow" aria-hidden="true">—</span>
          </article>

          <article class="layer-row" data-layer="escapes">
            <span class="layer-number">04</span>
            <h3 class="layer-name">Weekend Escapes</h3>
            <p class="layer-description">Find treks, forts, waterfalls and wildlife within driving distance.</p>
            <span class="layer-status">Coming soon</span>
            <span class="layer-arrow" aria-hidden="true">—</span>
          </article>

          <article class="layer-row" data-layer="lakes">
            <span class="layer-number">05</span>
            <h3 class="layer-name">Lakes</h3>
            <p class="layer-description">Understand the city’s water bodies, buffers and ecology.</p>
            <span class="layer-status">Coming soon</span>
            <span class="layer-arrow" aria-hidden="true">—</span>
          </article>

          <article class="layer-row" data-layer="heritage">
            <span class="layer-number">06</span>
            <h3 class="layer-name">Deccan Heritage</h3>
            <p class="layer-description">Explore monuments, stepwells, palaces and walking routes.</p>
            <span class="layer-status">Coming soon</span>
            <span class="layer-arrow" aria-hidden="true">—</span>
          </article>
        </div>
      </section>
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-title">Built in<br />Hyderabad.</p>
        <p class="footer-meta">Mapping the city as it changes.<br />© 2026 Mapping HYD.</p>
      </div>
    </footer>

    <script>
      const rows = document.querySelectorAll(".layer-row");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion && "IntersectionObserver" in window) {
        rows.forEach((row) => row.classList.add("reveal-ready"));
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.18 }
        );
        rows.forEach((row) => observer.observe(row));
      }
    </script>
  </body>
</html>
